# ZeroDB (Supabase → ZeroDB migration epic #1)
# Vite inlines VITE_* vars at BUILD time. Changes here require a rebuild,
# not just a server restart. In Railway, set these per environment
# (staging vs production) — see #12.
VITE_ZERODB_API_URL="https://api.ainative.studio/v1"
VITE_ZERODB_PROJECT_ID=""
VITE_ZERODB_API_KEY=""

# Provisioning-only (#16): the shared initial password baked into the
# admin script when creating staff users. Each user is forced to change it
# on first sign-in. Never set this on Railway — it's only read by
# scripts/zerodb/provision-users.ts when run locally by an admin.
ZERODB_TEMP_PASSWORD=""

# DEPRECATED — kept only during the transition window so Railway can
# fall back to shared-password auth if anything goes wrong. Remove once
# all 4 staff have rotated their passwords (#16).
VITE_CRM_PASSWORD=""
