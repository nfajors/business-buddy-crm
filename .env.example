# ZeroDB (Supabase → ZeroDB migration epic #1)
# Vite inlines VITE_* vars at BUILD time. Changes here require a rebuild,
# not just a server restart. In Railway, set these per environment
# (staging vs production) — see #12.
VITE_ZERODB_API_URL="https://api.ainative.studio/v1"
VITE_ZERODB_PROJECT_ID=""
VITE_ZERODB_API_KEY=""
# Auth: per-user ZeroDB accounts (no shared password).
# Users are provisioned via: scripts/zerodb/provision-users.ts
# See docs/guides/per-user-auth.md for details.
